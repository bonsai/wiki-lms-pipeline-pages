{
  "title": "🗺️ K2S Factory Process Map",
  "description": "bonsai/wiki を起点とした創作・分析・連携パイプラインの可視化。後から wiki / weave の2軸に統廃合しやすいよう、JSON データ駆動で記述。",
  "legend": {
    "S": "Subject（主体／エージェント）",
    "V": "Verb（動作）",
    "O": "Object（対象）"
  },
  "repos": [
    {
      "id": "wiki",
      "name": "bonsai/wiki",
      "emoji": "🌿",
      "axis": "wiki",
      "note": "知識の土壌。セカンドブレインとして育てられる。",
      "processes": [
        {
          "id": "maintain",
          "name": "セカンドブレインを育てる",
          "S": "human / agent",
          "V": "観察・記録・待つ",
          "O": "知見・日誌・アイデア",
          "output": "markdown corpus",
          "issue": null
        },
        {
          "id": "snapshot",
          "name": "snapshot を取得",
          "S": "pipeline agent",
          "V": "tarball 展開",
          "O": "repo contents",
          "output": "wiki-snapshot/",
          "issue": null
        }
      ]
    },
    {
      "id": "pipeline",
      "name": "wiki-lms-pipeline",
      "emoji": "🏭",
      "axis": "weave",
      "note": "LMS を使ったローカル創作工場。",
      "processes": [
        {"id": "ingest", "name": "ingest", "S": "pipeline", "V": "読み込む", "O": "md/txt/html files", "output": "chunks"},
        {"id": "embed", "name": "embed", "S": "pipeline", "V": "ベクトル化する", "O": "chunks", "output": "embeddings (nomic 768d)"},
        {"id": "tag", "name": "tag", "S": "gemma-4-e4b", "V": "分類する", "O": "file", "output": "tags（値のみ）"},
        {"id": "seed", "name": "seed pick", "S": "pipeline", "V": "採取する", "O": "interesting chunks", "output": "seeds"},
        {"id": "pollinate", "name": "pollinate", "S": "Camel Idea ↔ Critic", "V": "交叉・批評する", "O": "seeds", "output": "hybrid ideas"},
        {"id": "write", "name": "genre write", "S": "gemma-4-e4b", "V": "創作する", "O": "pollinated idea", "output": "draft (SF/落語/脚本/小説/企画/...)"},
        {"id": "quality", "name": "quality gate", "S": "gemma-4-e4b", "V": "採点・再生成する", "O": "draft", "output": "score >= 3.5"},
        {"id": "jev", "name": "jev classify", "S": "jev", "V": "振り分ける", "O": "output", "output": "agt / txt / data / tool"},
        {"id": "export_bqmlite", "name": "export bqmlite", "S": "pipeline", "V": "特徴量化する", "O": "reviewed drafts", "output": "bqmlite_input.json"},
        {"id": "publish", "name": "publish", "S": "pipeline", "V": "書き出す", "O": "good drafts", "output": "markdown files"},
        {"id": "notify", "name": "notify", "S": "pipeline", "V": "通知する", "O": "report", "output": "email / .eml"}
      ]
    },
    {
      "id": "wiki-weave-skill",
      "name": "bonsai/wiki-weave-skill",
      "emoji": "🧶",
      "axis": "weave",
      "note": "opencode / pi から呼ばれる wiki 編みスキル。",
      "processes": [
        {"id": "weave", "name": "wiki を編む", "S": "opencode/pi skill", "V": "編む", "O": "wiki chunks", "output": "woven content"}
      ]
    },
    {
      "id": "t2t",
      "name": "bonsai/t2t",
      "emoji": "🧬",
      "axis": "weave",
      "note": "text-to-text 遺伝的出産プロトコル。",
      "processes": [
        {"id": "reproduce", "name": "t2t reproduce", "S": "parent texts", "V": "出産・交叉する", "O": "DNA at interface", "output": "child text", "issue": "https://github.com/bonsai/t2t/issues/1"}
      ]
    },
    {
      "id": "r2r",
      "name": "bonsai/r2r",
      "emoji": "🔀",
      "axis": "weave",
      "note": "A2A 発想の repo-to-repo プロトコル。",
      "processes": [
        {"id": "broker", "name": "r2r broker", "S": "repo agent", "V": "発見・依頼・返す", "O": "capability / request", "output": "artifact", "issue": "https://github.com/bonsai/r2r/issues/1"}
      ]
    },
    {
      "id": "bqmlite",
      "name": "bonsai/bqmlite",
      "emoji": "📊",
      "axis": "weave",
      "note": "ローカル ML / 回帰分析。テキストは数値化してから。",
      "processes": [
        {"id": "regress", "name": "linear regression", "S": "bqmlite", "V": "回帰する", "O": "numeric features", "output": "quality prediction"},
        {"id": "sakura_embed", "name": "Sakura embed", "S": "Sakura API", "V": "ベクトル化する", "O": "text", "output": "embeddings (2560d) — あとで", "issue": "https://github.com/bonsai/bqmlite/issues/12"},
        {"id": "bq_export", "name": "home BQ export", "S": "pipeline", "V": "出力する", "O": "features", "output": "BigQuery at home — あとで", "issue": "https://github.com/bonsai/bqmlite/issues/12"}
      ]
    },
    {
      "id": "output",
      "name": "outputs",
      "emoji": "🎁",
      "axis": "weave",
      "note": "最終成果物。",
      "processes": [
        {"id": "creative", "name": "creative works", "S": "genre writer", "V": "生成する", "O": "idea", "output": "絵本・4コマ・SF・落語・脚本・恋愛小説・企画書"},
        {"id": "quiz", "name": "review quiz", "S": "agent", "V":  "出題する", "O": "knowledge chunks", "output": "復習クイズ"}
      ]
    }
  ],
  "flows": [
    {"from": "wiki.maintain", "to": "wiki.snapshot", "label": "日々更新"},
    {"from": "wiki.snapshot", "to": "pipeline.ingest", "label": "tarball"},
    {"from": "pipeline.ingest", "to": "pipeline.embed", "label": "chunks"},
    {"from": "pipeline.embed", "to": "pipeline.tag", "label": "vectors"},
    {"from": "pipeline.tag", "to": "pipeline.seed", "label": "tags"},
    {"from": "pipeline.seed", "to": "pipeline.pollinate", "label": "seeds"},
    {"from": "pipeline.pollinate", "to": "pipeline.write", "label": "hybrid ideas"},
    {"from": "pipeline.write", "to": "pipeline.quality", "label": "drafts"},
    {"from": "pipeline.quality", "to": "pipeline.jev", "label": ">=3.5"},
    {"from": "pipeline.jev", "to": "pipeline.publish", "label": "分類済み"},
    {"from": "pipeline.jev", "to": "pipeline.export_bqmlite", "label": "features"},
    {"from": "pipeline.export_bqmlite", "to": "bqmlite.regress", "label": "json"},
    {"from": "bqmlite.sakura_embed", "to": "bqmlite.regress", "label": "2560d vec", "style": "stroke-dasharray: 5 5"},
    {"from": "pipeline.publish", "to": "output.creative", "label": "files"},
    {"from": "pipeline.publish", "to": "pipeline.notify", "label": "report"},
    {"from": "wiki-weave-skill.weave", "to": "pipeline.seed", "label": "skill経由"},
    {"from": "t2t.reproduce", "to": "pipeline.pollinate", "label": "交配ルール", "style": "stroke-dasharray: 5 5"},
    {"from": "r2r.broker", "to": "pipeline.write", "label": "委託タスク", "style": "stroke-dasharray: 5 5"}
  ]
}
